# PAYGUARD deployment environment
# Copy to .env and replace every placeholder before starting the stack.
# Never commit a real .env file or production secrets.

POSTGRES_DB=payguard
POSTGRES_USER=payguard
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Browser-facing API URL baked into the production frontend image.
VITE_API_URL=http://localhost:8080

# Backend CORS allow-list.
PAYGUARD_ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=docker

# Optional host port overrides.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
ML_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=5173
