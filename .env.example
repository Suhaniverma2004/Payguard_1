# PAYGUARD Docker environment
# Copy this file to .env before running docker compose.
# Never commit a real .env file or real secrets.

POSTGRES_DB=payguard
POSTGRES_USER=payguard
POSTGRES_PASSWORD=replace-with-a-local-db-password

# Generate a long random value for local/deployment use.
# Example: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Frontend origin(s), comma-separated if needed.
PAYGUARD_ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=docker
